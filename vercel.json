{
  "version": 2,
  "functions": {
    "api/auth/line/login.ts": {
      "runtime": "@vercel/node@3"
    },
    "api/auth/line/callback.ts": {
      "runtime": "@vercel/node@3"
    },
    "api/auth/line/verify.ts": {
      "runtime": "@vercel/node@3"
    },
    "api/me/stats.ts": {
      "runtime": "@vercel/node@3"
    }
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/leaderboard.html",
      "dest": "/public/leaderboard.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/test-simple.html", 
      "dest": "/public/test-simple.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/game.html",
      "dest": "/public/game.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/index.html",
      "dest": "/public/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
