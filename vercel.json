{
  "version": 2,
  "builds": [
    {
      "src": "web_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "web_app.py"
    },
    {
      "src": "/public/(.*)",
      "dest": "web_app.py"
    },
    {
      "src": "/(.*)",
      "dest": "web_app.py"
    }
  ],
  "env": {
    "PYTHONPATH": "/var/task",
    "FLASK_ENV": "production"
  },
  "functions": {
    "web_app.py": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "templates/**,static/**,public/**"
    }
  }
}